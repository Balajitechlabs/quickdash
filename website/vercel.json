{
  "rewrites": [
    {
      "source": "/downloads/:path*",
      "destination": "https://github.com/balajitechlabs/quickdash/releases/latest/download/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon|site\\.webmanifest|robots\\.txt|sitemap\\.xml|CNAME|apple-touch-icon\\.png|privacy-policy\\.html|_redirects).*)",
      "destination": "/index.html"
    }
  ]
}
