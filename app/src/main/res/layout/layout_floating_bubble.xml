<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="12dp">

    <!-- The draggable bubble icon. Single tap = dashboard. Long press = pinned tools radial menu. -->
    <ImageView
        android:id="@+id/img_bubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:padding="10dp"
        android:background="@drawable/bg_bubble_circle"
        android:contentDescription="QuickDash Bubble" />

    <!-- Stub view kept so existing R.id references in the service don't crash -->
    <View
        android:id="@+id/layout_bubble_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
